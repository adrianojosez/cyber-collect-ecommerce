<section class="my-orders container">
  <div class="my-orders__header">
    <h1>Meus Pedidos</h1>
    <p>Acompanhe o histórico de suas compras na Cyber-Collect</p>
  </div>

  <!-- Pontos de Fidelidade Banner -->
  <div class="loyalty-banner">
    <div class="loyalty-banner__content">
      <i class="fas fa-medal loyalty-banner__icon"></i>
      <% if (userPoints > 0) { %>
        <span class="loyalty-banner__text">Você possui <strong><%= userPoints %></strong> pontos de fidelidade!</span>
        <small class="loyalty-banner__subtitle">🚀 Em breve: Troque seus pontos por descontos exclusivos em suas próximas compras!</small>
      <% } else { %>
        <span class="loyalty-banner__text">Faça sua primeira compra e comece a ganhar pontos!</span>
        <small class="loyalty-banner__subtitle">🚀 Em breve: Troque seus pontos por descontos exclusivos em suas próximas compras!</small>
      <% } %>
    </div>
  </div>

  <% if (!orders || orders.length === 0) { %>
    <div class="my-orders__empty">
      <div class="my-orders__empty-icon">
        <i class="fas fa-inbox fa-4x"></i>
      </div>
      <p>Você ainda não realizou nenhuma compra.</p>
      <a href="/" class="button button__blue">Começar Compras</a>
    </div>
  <% } else { %>
    <div class="my-orders__content">
      <!-- Desktop Table -->
      <div class="my-orders__table">
        <table>
          <thead>
            <tr>
              <th>ID do Pedido</th>
              <th>Data</th>
              <th>Valor Total</th>
              <th>Status</th>
              <th>Ações</th>
            </tr>
          </thead>
          <tbody>
            <% orders.forEach(order => { %>
              <tr>
                <td class="my-orders__id">#<%= order.id %></td>
                <td class="my-orders__date"><%= order.created_at_formatted %></td>
                <td class="my-orders__total"><%= order.total_price_formatted %></td>
                <td class="my-orders__status">
                  <span class="status-badge status-<%= order.status %>">
                    <%= order.status %>
                  </span>
                </td>
                <td class="my-orders__actions">
                  <a href="/pedido/<%= order.id %>" class="btn-small btn-view">Ver Detalhes</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <!-- Mobile Cards -->
      <div class="my-orders__cards">
        <% orders.forEach(order => { %>
          <div class="my-orders__card">
            <div class="my-orders__card-header">
              <h3>Pedido #<%= order.id %></h3>
              <span class="status-badge status-<%= order.status %>">
                <%= order.status %>
              </span>
            </div>
            <div class="my-orders__card-body">
              <div class="card-row">
                <span class="card-label">Data:</span>
                <span class="card-value"><%= order.created_at_formatted %></span>
              </div>
              <div class="card-row">
                <span class="card-label">Valor Total:</span>
                <span class="card-value card-total"><%= order.total_price_formatted %></span>
              </div>
            </div>
            <div class="my-orders__card-footer">
              <a href="/pedido/<%= order.id %>" class="button button__primary">Ver Detalhes</a>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

    <div class="my-orders__footer">
      <a href="/" class="button button__outline">Voltar às Compras</a>
    </div>
  <% } %>
</section>

