      <form action="/contato" method="POST" class="contact__form">
        <fieldset>
          <legend>Fale conosco</legend>
          <label for="name" class="sr-only">Escreva seu nome</label>
          <input
            id="name"
            name="name"
            type="text"
            class=""
            data-type="contact"
            maxlength="40"
            placeholder="Nome"
            required
          />
          <span role="alert"></span>
          <label for="email" class="sr-only">Digite seu email</label>
          <input
            id="email"
            name="email"
            type="email"
            class=""
            data-type="contact"
            maxlength="80"
            placeholder="Email"
            required
          />
          <span role="alert"></span>
          <label for="subject" class="sr-only">Selecione o assunto</label>
          <select id="subject" name="subject" class="" required>
            <option value="">Selecione o assunto</option>
            <option value="Dúvida">Dúvida</option>
            <option value="Devolução">Devolução</option>
            <option value="Sugestão">Sugestão</option>
            <option value="Outros">Outros</option>
          </select>
          <span role="alert"></span>
          <label for="message" class="sr-only">Escreva sua mensagem</label>
          <textarea
            name="message"
            id="message"
            class=""
            data-type="contact"
            placeholder="Escreva sua mensagem"
            maxlength="120"
            required
          ></textarea>
          <span role="alert"></span>
          <button type="submit" class="button__blue button">
            Enviar mensagem
          </button>
        </fieldset>
      </form>
