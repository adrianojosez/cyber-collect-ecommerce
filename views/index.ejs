  <body>
    <!-- Cabeçalho -->
    <header class="header container">
      <div>

        <!-- <a class="header__logo" href="/" id="header">
          <img
            class="header__logo--img"
            src="/images/logo.svg"
            alt="Loja Informática"
          />
        </a> -->
        
        <a class="header__logo" href="/" id="header" style="text-decoration: none;">
          <span style="font-family: 'Press Start 2P', cursive; color: #2A7AE4; font-size: 14px;">C_C</span>
        </a>

        <form action="/search" method="GET" class="header__form">
          <label for="h__input" class="sr-only">
            Digite o que está procurando
          </label>
          <input
            type="search"
            id="h__input"
            name="search"
            class="header__input"
            minlength="3"
            placeholder="O que deseja procurar?"
          />
          <button type="submit" style="display: none"></button>
        </form>
      </div>
      <div class="header__buttons" style="display: flex; gap: 16px; align-items: center;">

<% if (locals.user && user.name) { %>
    <span class="user__name">Olá, <strong><%= user.name %></strong></span>
    
    <% if (user.tipo === 'admin') { %>
        <a href="/admin/dashboard" class="button" style="background-color: #2A7AE4; color: white; padding: 8px 16px; border-radius: 4px; text-decoration: none; font-weight: bold; margin-right: 8px;">Painel</a>
        <a href="/admin/todos-os-produtos" class="button" style="background-color: #555; color: white; padding: 8px 16px; border-radius: 4px; text-decoration: none; font-weight: bold; margin-right: 8px;">Gerenciar</a>
        <a href="/admin/usuarios" class="button" style="background-color: #9b59b6; color: white; padding: 8px 16px; border-radius: 4px; text-decoration: none; font-weight: bold; margin-right: 8px;">Usuários</a>
    <% } %>

    <a href="/cart" class="button" style="background-color: #2A7AE4; color: white; padding: 8px 12px; border-radius: 4px; text-decoration: none; font-weight: bold; margin-right: 8px; position: relative;">
      <i class="fas fa-shopping-cart" style="font-size: 16px;"></i>
      <% if (cartItemCount > 0) { %>
        <span class="cart-badge" style="position: absolute; top: -8px; right: -8px; background: #ff4d4d; color: white; border-radius: 50%; padding: 2px 6px; font-size: 12px; font-weight: bold; min-width: 18px; text-align: center;"><%= cartItemCount %></span>
      <% } %>
    </a>
    <a href="/logout" class="button" style="background-color: #ff4d4d; color: white; padding: 8px 12px; border-radius: 4px; text-decoration: none; font-weight: bold; margin-right: 8px;">Sair</a>
    <button id="theme-toggle" class="button" style="background: none; border: none; cursor: pointer; font-size: 20px;">
      🌙
    </button>
<% } else { %>
    <%- button %>
    <a href="/cadastro" class="button__blue button">Cadastrar</a>
<% } %>
      </div>
      <!-- <a class="header__button button__void button" href="login">Login</a> -->
      <i class="header__search icon-search"></i>
      <i class="header__search icon-plus"></i>
