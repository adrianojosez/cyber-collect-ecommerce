<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta property="og:image" content="/images/logo.svg" />
    <meta name="author" content="Adriano José" />
    <meta 
      name="description" 
      content="Cyber-Collect: Sistema de e-commerce especializado em hardware e colecionáveis, desenvolvido para o TCC de ADS - FATEC Baixada Santista." 
    />
    <link rel="icon" href="/images/fav.svg" type="image/icon type" />
    <title>Loja Informática | <%- title %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Raleway:wght@400;500;600;700&family=Press+Start+2P&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/styles/index.css" />
  </head>

  <body>
    <!-- Cabeçalho -->
    <header class="header container">
      <div>

        <!-- <a class="header__logo" href="/" id="header">
          <img
            class="header__logo--img"
            src="/images/logo.svg"
            alt="Loja Informática"
          />
        </a> -->
        
        <a class="header__logo" href="/" id="header" style="text-decoration: none;">
          <span style="font-family: 'Press Start 2P', cursive; color: #2A7AE4; font-size: 14px;">C_C</span>
        </a>

        <form action="/search" method="POST" class="header__form">
          <label for="h__input" class="sr-only">
            Digite o que está procurando
          </label>
          <input
            type="search"
            id="h__input"
            name="search"
            class="header__input"
            minlength="3"
            placeholder="O que deseja procurar?"
          />
          <button type="submit" style="display: none"></button>
        </form>
      </div>
      <div class="header__buttons" style="display: flex; gap: 16px; align-items: center;">

<% if (locals.user && user.name) { %>
    <span class="user__name">Olá, <strong><%= user.name %></strong></span>
    
    <% if (user.tipo === 'admin') { %>
        <a href="/admin/dashboard" class="button" style="background-color: #2A7AE4; color: white; padding: 8px 16px; border-radius: 4px; text-decoration: none; font-weight: bold; margin-right: 8px;">Painel de Controle</a>
        
        <a href="/todos-os-produtos" class="button" style="background-color: #555; color: white; padding: 8px 16px; border-radius: 4px; text-decoration: none; font-weight: bold; margin-right: 8px;">Gerenciar Produtos</a>
    <% } %>

    <a href="/logout" class="button" style="background-color: #ff4d4d; color: white; padding: 8px 16px; border-radius: 4px; text-decoration: none;">Sair</a>
<% } else { %>
    <%- button %> 
    <a href="/cadastro" class="button__blue button">Cadastrar</a>
<% } %>
        
        <button id="theme-toggle" class="button" style="background: none; border: none; cursor: pointer; font-size: 20px;">
        🌙
    </button>
      <!-- <%- button %>  -->
      <!-- <a href="/cadastro" class="button__blue button">Cadastrar</a> -->
      </div>
      <!-- <a class="header__button button__void button" href="login">Login</a> -->
      <i class="header__search icon-search"></i>
      <i class="header__search icon-plus"></i>
    </header>

    <main>
      <!-- The page will render the correct page according to the URL/routes -->
      <%- include(`parts/${page}`) %>
    </main>

    <!-- Contato -->
    <section class="contact container">
      <div class="contact__links">
        <a class="contact__links--logo" href="#header">
          <!-- <img src="/images/logo.svg" alt="TCC" /> -->
        </a>
        <ul>
          <li><a href="/quem-somos">Quem somos nós</a></li>
          <li><a href="/politica">Política de privacidade</a></li>
          <li><a href="/fidelidade">Programa fidelidade</a></li>
          <li><a href="/lojas">Nossas lojas</a></li>
          <li><a href="/franqueado">Quero ser franqueado</a></li>
          <li><a href="/anuncie">Anuncie aqui</a></li>
          <li><a href="/termos">Termos de Uso e Garantia</a></li>
          <li><a href="/faq">FAQ</a></li>

          <!-- <li><a href="#">Página de Comparativo de Produtos</a></li> -->
          <!-- Conteúdo: Uma tela onde o usuário seleciona dois produtos (ex: duas placas de vídeo) e o sistema mostra uma tabela comparando as especificações técnicas (Memória, Clock, Preço).
          Diferencial para o TCC: Isso demonstra que seu banco de dados (db.json) é bem estruturado, permitindo cruzar informações técnicas complexas, o que é muito valorizado em cursos de ADS. -->

          <!-- <li><a href="#">404</a></li> -->
          <!-- Criar uma página 404 -->
        </ul>
      </div>

      <form action="" class="contact__form">
        <fieldset>
          <legend>Fale conosco</legend>
          <label for="name" class="sr-only">Escreva seu nome</label>
          <input
            id="name"
            type="text"
            class=""
            data-type="contact"
            maxlength="40"
            placeholder="Nome"
            required
          />
          <span role="alert"></span>
          <label for="message" class="sr-only">Escreva sua mensagem</label>
          <textarea
            name=""
            id="message"
            class=""
            data-type="contact"
            placeholder="Escreva sua mensagem"
            maxlength="120"
            required
          ></textarea>
          <span role="alert"></span>
          <button type="submit" class="button__blue button">
            Enviar mensagem
          </button>
        </fieldset>
      </form>
    </section>

    <!-- Rodapé -->

    <section class="benefits container">
    <div class="benefit__item">
        <img src="https://img.icons8.com/fluency/48/null/shipped.png" alt="Frete">
        <div>
            <h4>Frete Grátis</h4>
            <p>Em compras acima de R$ 199</p>
        </div>
    </div>
    <!-- <div class="benefit__item">
        <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/d/d6/Checkmark_green.svg/64px-Checkmark_green.svg.png" alt="Segurança">
        <div>
            <h4>Compra Garantida</h4>
            <p>Seu dinheiro sempre seguro</p>
        </div>
    </div> -->
    <div class="benefit__item">
        <img src="https://img.icons8.com/fluency/48/null/headphones.png" alt="Suporte">
        <div>
            <h4>Suporte 24h</h4>
            <p>Atendimento especializado</p>
        </div>
    </div>
</section>

<footer class="footer">
    <div class="footer__container container">
        
        <div class="footer__column">
            <h3 class="footer__title">ATENDIMENTO</h3>
            <ul class="footer__list">
                <li><a href="/central-ajuda">Central de Ajuda</a></li>
                <li><a href="/quem-somos">Sobre Nós</a></li>
                <li><a href="/politica">Política de Privacidade</a></li>
                <li><a href="/anuncie">Anuncie aqui</a></li>
                <li><a href="/faq">FAQ</a></li>
            </ul>
        </div>

        <div class="footer__column">
            <h3 class="footer__title">PAGAMENTO</h3>
          <div class="footer__payments">
              <span class="tooltip" data-text="Cartão Visa">
                  <img src="https://img.icons8.com/color/48/000000/visa.png" alt="Visa">
              </span>
              <span class="tooltip" data-text="Cartão Mastercard">
                  <img src="https://img.icons8.com/color/48/000000/mastercard.png" alt="Mastercard">
              </span>
              <span class="tooltip" data-text="American Express">
                  <img src="https://img.icons8.com/color/48/000000/amex.png" alt="Amex">
              </span>
              <span class="tooltip" data-text="Boleto Bancário">
                  <img src="https://cdn-icons-png.flaticon.com/512/438/438526.png" alt="Boleto">
              </span>
              <span class="tooltip" data-text="Pagamento via Pix">
                  <img src="https://img.icons8.com/color/48/000000/pix.png" alt="Pix">
              </span>
          </div>
        </div>

        <div class="footer__column">
    <h3 class="footer__title">SEGURANÇA</h3>
    <div class="footer__security">
        <img src="https://img.icons8.com/color/48/null/google-logo.png" alt="Google Safe" title="Site verificado pelo Google">
        <!-- <img src="https://res.cloudinary.com/drw5h8xat/image/upload/v1727546369/lock-solid_q4k4p5.png" alt="SSL" title="Certificado SSL Ativo">
        <img src="https://res.cloudinary.com/drw5h8xat/image/upload/v1727546369/check-square-solid_a2s5k7.png" alt="PCI" title="Conformidade de Dados"> -->
    </div>
</div>

        <div class="footer__column">
            <h3 class="footer__title">SIGA-NOS</h3>
            <div class="footer__socials">
                <a href="#"><img src="https://img.icons8.com/fluent/48/000000/instagram-new.png" alt="Instagram"><span>Instagram</span></a>
                <a href="#"><img src="https://img.icons8.com/fluent/48/000000/facebook-new.png" alt="Facebook"><span>Facebook</span></a>
                <a href="#"><img src="https://img.icons8.com/fluent/48/000000/linkedin.png" alt="Linkedin"><span>Linkedin</span></a>
                <a href="#"><img src="https://img.icons8.com/fluent/48/000000/tiktok.png" alt="TikTok"><span>TikTok</span></a>
            </div>
        </div>

        <div class="footer__column footer__app-section">
            <h3 class="footer__title">BAIXAR APP</h3>
            <div class="footer__app-wrapper">
                <img src="https://api.qrserver.com/v1/create-qr-code/?size=100x100&data=SeuTCC" alt="QR Code" class="footer__qrcode">
                <div class="footer__app-buttons">
                    <a href="#"><img src="https://tools.applemediaservices.com/api/badges/download-on-the-app-store/black/pt-br?size=250x83" alt="App Store" class="app-btn"></a>
                    <a href="#"><img src="https://play.google.com/intl/en_us/badges/static/images/badges/pt-br_badge_web_generic.png" alt="Google Play" class="app-btn"></a>
                </div>
            </div>
        </div>

    </div>

    <div class="footer__bottom">
        <p>Cyber-Collect © 2026. Todos os direitos reservados. CNPJ: 00.000.000/0001-00</p>
        <p>Desenvolvido por Adriano José. Jesus é o caminho, a verdade e a vida.</p>
    </div>
</footer>

    <!-- MODAL -->
    <div class="modal-wrapper">
      <div class="modal">
        <h2>Excluir produto</h2>
        <p>Tem certeza que você deseja excluir este produto?</p>
        <form action="#" method="POST">
          <!-- Method POST to send data do backend. The action (which will be the URL) will be defined with JS -->
          <label class="sr-only" for="password">Confirme sua senha admin</label>
          <input
            type="password"
            name="password"
            id="password"
            placeholder="Confirme sua senha"
            required
          />
          <div class="buttons">
            <div class="button button__blue cancel">Cancelar</div>
            <button class="button button__red delete">Sim, excluir</button>
          </div>
        </form>
      </div>
    </div>

    <script type="module" src="/scripts/main.js"></script>
    <script type="module" src="/scripts/forms.js"></script>
    <script src="/scripts/drag-n-drop.js"></script>
    <script src="https://github.com/codermarcos/simple-mask-money/releases/download/v3.0.0/simple-mask-money.js"></script>

    <a href="#header" class="back-to-top" title="Voltar ao topo">
        <i class="icon-arrow-up">↑</i> 
    </a>

  </body>
</html>
