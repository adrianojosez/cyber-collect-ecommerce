<section class="payment container">
  <div class="payment__header">
    <h1>Pagamento</h1>
    <p>Confirme seus dados e finalize o pedido com segurança.</p>
  </div>

  <div class="payment__content">
    <div class="payment__card payment__summary-card">
      <h2>Resumo do pedido</h2>
      <div class="summary__item">
        <span>Itens no carrinho</span>
        <strong><%= cart.length %></strong>
      </div>
      <div class="summary__item">
        <span>Frete</span>
        <strong>Grátis</strong>
      </div>
      <div class="summary__total">
        <span>Total a pagar</span>
        <strong><%= totalFormatted %></strong>
      </div>
      <p class="payment__hint">Esta é uma simulação de pagamento. Após confirmar, seu pedido será registrado e você será redirecionado para a página de pedidos.</p>
    </div>

    <div class="payment__card payment__form-card">
      <div class="payment__tabs" role="tablist" aria-label="Opções de pagamento">
        <button type="button" class="payment__tab payment__tab--active" data-tab="pix">PIX</button>
        <button type="button" class="payment__tab" data-tab="card">Cartão de Crédito</button>
      </div>

      <form action="/checkout" method="POST" class="payment__form" id="paymentForm">
        <input type="hidden" name="paymentMethod" id="paymentMethod" value="pix" />

        <div class="payment__pane payment__pane--active" id="pixPane">
          <div class="pix__box">
            <div class="pix__header">
              <span class="pix__label">PIX de exemplo</span>
              <span class="pix__status">Pagamento instantâneo</span>
            </div>
            <div class="pix__qrcode">
              <img src="https://dummyimage.com/220x220/2a7ae4/ffffff.png&text=QR+Code" alt="QR Code PIX" />
            </div>
            <div class="pix__code-group">
              <label for="pixCode">Código PIX</label>
              <textarea id="pixCode" class="pix__code" readonly>00020126580014br.gov.bcb.pix0114+55119999999952040000530398654041.505802BR5925CYBER COLLECT LTDA6009SAO PAULO62070503***63041D3F</textarea>
              <button type="button" class="button button__secondary" onclick="copyPixCode(event)">Copiar Código</button>
            </div>
          </div>
        </div>

        <div class="payment__pane" id="cardPane">
          <div class="field-group">
            <label for="cardName">Nome no Cartão</label>
            <input id="cardName" name="cardName" type="text" placeholder="Nome completo" autocomplete="cc-name" />
          </div>
          <div class="field-group">
            <label for="cardNumber">Número do Cartão</label>
            <input id="cardNumber" name="cardNumber" type="text" placeholder="0000 0000 0000 0000" maxlength="19" autocomplete="cc-number" />
          </div>
          <div class="field-row">
            <div class="field-group field-group--small">
              <label for="cardExpiry">Validade</label>
              <input id="cardExpiry" name="cardExpiry" type="text" placeholder="MM/AA" maxlength="5" autocomplete="cc-exp" />
            </div>
            <div class="field-group field-group--small">
              <label for="cardCvv">CVV</label>
              <input id="cardCvv" name="cardCvv" type="text" placeholder="123" maxlength="4" autocomplete="cc-csc" />
            </div>
          </div>
        </div>

        <button type="submit" class="button button__primary payment__submit">🔒 Confirmar e Finalizar Pagamento</button>
      </form>
    </div>
  </div>
</section>

<script>
  const tabs = document.querySelectorAll('.payment__tab')
  const panes = document.querySelectorAll('.payment__pane')
  const paymentMethodInput = document.getElementById('paymentMethod')

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(button => button.classList.remove('payment__tab--active'))
      panes.forEach(pane => pane.classList.remove('payment__pane--active'))

      tab.classList.add('payment__tab--active')
      const selectedPane = document.getElementById(`${tab.dataset.tab}Pane`)
      selectedPane.classList.add('payment__pane--active')
      paymentMethodInput.value = tab.dataset.tab
    })
  })

  function copyPixCode(event) {
    const codeField = document.getElementById('pixCode')
    codeField.select()
    document.execCommand('copy')

    const button = event.target
    const originalText = button.textContent
    button.textContent = 'Copiado!'
    setTimeout(() => {
      button.textContent = originalText
    }, 1500)
  }
</script>
