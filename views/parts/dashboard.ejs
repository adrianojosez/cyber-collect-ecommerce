<section class="dashboard container">
    <h2>Business Intelligence</h2>

    <!-- Menu de Navegação Admin -->
    <div style="background: #f4f4f4; padding: 15px; border-radius: 8px; margin-bottom: 2rem;">
        <h3 style="margin-bottom: 1rem; color: #2A7AE4;">Menu Administrativo</h3>
        <div style="display: flex; gap: 15px; flex-wrap: wrap;">
            <a href="/admin/todos-os-produtos" style="background: #555; color: white; padding: 8px 16px; border-radius: 4px; text-decoration: none; font-weight: bold;">Gerenciar Produtos</a>
            <a href="/admin/usuarios" style="background: #9b59b6; color: white; padding: 8px 16px; border-radius: 4px; text-decoration: none; font-weight: bold;">Gerenciar Usuários</a>
            <a href="/logout" style="background: #ff4d4d; color: white; padding: 8px 16px; border-radius: 4px; text-decoration: none; font-weight: bold;">Sair</a>
        </div>
    </div>

    <!-- KPIs Section -->
    <div class="dash__cards">
        <div class="dash__card--blue">
            <p>TOTAL DE ITENS</p>
            <h3><%= stats.total %></h3>
        </div>
        <div class="dash__card--green">
            <p>VALOR DO PATRIMÔNIO</p>
            <h3><%= stats.inventoryValue %></h3>
        </div>
        <div class="dash__card--yellow">
            <p>TICKET MÉDIO</p>
            <h3><%= stats.avg %></h3>
        </div>
        <div class="dash__card--purple">
            <p>PRODUTO PREMIUM</p>
            <h3><%= stats.mostExpensive ? stats.mostExpensive.name : 'N/A' %></h3>
            <p><%= stats.mostExpensive ? stats.mostExpensive.price : '' %></p>
        </div>
    </div>

    <!-- Distribuição por Categoria -->
    <div class="category-table">
        <h4>Distribuição por Categoria</h4>
        <table>
            <thead>
                <tr>
                    <th>Categoria</th>
                    <th>Quantidade</th>
                </tr>
            </thead>
            <tbody>
                <% stats.categories.forEach(cat => { %>
                    <tr>
                        <td><%= cat.category %></td>
                        <td><%= cat.count %></td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>

    <!-- Novos Gráficos Analíticos -->
    <div class="charts-row">
        <!-- Gráfico de Faixas de Preço -->
        <div class="chart-container">
            <h4>Distribuição por Faixa de Preço</h4>
            <canvas id="priceRangeChart"></canvas>
        </div>

        <!-- Gráfico Top 5 Investimento -->
        <div class="chart-container">
            <h4>Top 5 Produtos por Valor</h4>
            <canvas id="top5Chart"></canvas>
        </div>
    </div>

    <!-- Gráfico de Pizza -->
    <div class="chart-container chart-center">
        <h4>Produtos por Categoria</h4>
        <canvas id="categoryChart"></canvas>
    </div>

    <!-- Gerenciamento de Produtos -->
    <div class="products-table">
        <h4>Gerenciamento de Produtos</h4>
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>Categoria</th>
                    <th>Preço</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                <% stats.products.forEach(product => { %>
                    <tr>
                        <td><%= product.id %></td>
                        <td><%= product.name %></td>
                        <td><%= product.category %></td>
                        <td><%= product.price %></td>
                        <td>
                            <a href="/editar&id=<%= product.id %>">Editar</a>
                            <form action="/admin/todos-os-produtos/<%= product.id %>/delete" method="POST" style="display: inline;">
                                <button type="submit">Excluir</button>
                            </form>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // Gráfico de Pizza - Categorias
    const ctx = document.getElementById('categoryChart').getContext('2d');
    const categories = <%- JSON.stringify(stats.categories) %>;
    
    new Chart(ctx, {
        type: 'pie',
        data: {
            labels: categories.map(c => c.category),
            datasets: [{
                data: categories.map(c => c.count),
                backgroundColor: ['#2A7AE4', '#ff4d4d', '#f1c40f', '#2ecc71', '#9b59b6']
            }]
        },
        options: {
            responsive: true,
            plugins: {
                legend: {
                    position: 'bottom'
                }
            }
        }
    });

    // Gráfico de Barras - Faixas de Preço
    const priceCtx = document.getElementById('priceRangeChart').getContext('2d');
    const priceRanges = <%- JSON.stringify(stats.priceRanges) %>;
    
    new Chart(priceCtx, {
        type: 'bar',
        data: {
            labels: Object.keys(priceRanges),
            datasets: [{
                label: 'Quantidade de Produtos',
                data: Object.values(priceRanges),
                backgroundColor: '#2A7AE4',
                borderColor: '#1a5aa8',
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        stepSize: 1
                    }
                }
            },
            plugins: {
                legend: {
                    display: false
                }
            }
        }
    });

    // Gráfico de Barras Horizontais - Top 5 Produtos
    const top5Ctx = document.getElementById('top5Chart').getContext('2d');
    const top5Products = <%- JSON.stringify(stats.top5Products) %>;
    
    new Chart(top5Ctx, {
        type: 'bar',
        data: {
            labels: top5Products.map(p => p.name.length > 20 ? p.name.substring(0, 20) + '...' : p.name),
            datasets: [{
                label: 'Valor (R$)',
                data: top5Products.map(p => parseFloat(p.price.replace('R$ ', '').replace('.', '').replace(',', '.'))),
                backgroundColor: '#2ecc71',
                borderColor: '#27ae60',
                borderWidth: 1
            }]
        },
        options: {
            indexAxis: 'y',
            responsive: true,
            scales: {
                x: {
                    beginAtZero: true,
                    ticks: {
                        callback: function(value) {
                            return 'R$ ' + value.toLocaleString('pt-BR');
                        }
                    }
                }
            },
            plugins: {
                legend: {
                    display: false
                },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            return 'Valor: R$ ' + context.parsed.x.toLocaleString('pt-BR');
                        }
                    }
                }
            }
        }
    });
</script>